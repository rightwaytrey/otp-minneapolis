backend/venv/

# Environment files
.env
pelias/.env

# Claude Code local config
.claude/

# Keep data directory structure
!data/.gitkeep
!data/README.md

# deployment/ — Linode migration. These hold live secrets (Cloudflare token,
# Stadia key, Tailscale auth key) and per-instance facts. The nginx templates
# in deployment/nginx/ are safe: they carry __PLACEHOLDER__ tokens that
# deploy-app.sh substitutes at install time.
deployment/.env
# ... and every backup of it. `cp .env .env.bak.$(date +%Y%m%d-%H%M%S)` before a
# secret rotation is the sane move, and it produced an UNTRACKED file holding
# the pre-rotation unlock secret sitting next to a gitignored one -- one
# `git add -A` from the exact accident backlog 2.10 was about (a live credential
# in a PUBLIC repo for three months).
deployment/.env.bak*
deployment/.env.*.bak
deployment/server-info.txt

# Nightly verify output: cron artifacts from scripts/nightly-verify.sh (~1.4 MB/night).
data/nightly-verify/

# Deploy manifests: a record of what is on a particular box, written at deploy
# time by scripts/deploy-manifest.py. Per-host state, never source.
deployment/deploy-manifest.json
deployment/rendered/

# Python bytecode caches
__pycache__/
*.pyc
