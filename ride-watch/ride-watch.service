[Unit]
Description=ride-watch — live Go Mode telemetry anomaly watcher
Documentation=file:///home/rwt/projects/otp-minneapolis/ride-watch/README.md
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /home/rwt/projects/otp-minneapolis/ride-watch/ride_watch.py
WorkingDirectory=/home/rwt/projects/otp-minneapolis
Restart=on-failure
RestartSec=10
# The daemon shells out to `tmux` to run the ride thread, and the pane it
# starts re-exports its own PATH (a tmux server started by another client does
# not inherit this one). `claude` itself lives in ~/.local/bin, which is NOT on
# a systemd user service's default PATH; the stable symlink is on the path
# rather than the versioned binary, so a CLI upgrade cannot silently disarm it.
Environment=PATH=/home/rwt/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# The kill switch. Set to 0 and the daemon behaves exactly as it did before
# ride threads existed: rules, pages and current-ride.md, no conversation.
Environment=RIDE_THREAD_ENABLED=1
# The ride thread is a tmux session, not a child of this unit — but the worker
# thread that types into it is, and a restart mid-ride must not take the
# rider's live conversation down with it or leave a send-keys half-done.
KillMode=process
TimeoutStopSec=30
StandardOutput=null
StandardError=journal
SyslogIdentifier=ride-watch

[Install]
WantedBy=default.target
