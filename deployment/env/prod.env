# prod.env — value set for the Linode, rendered by render-nginx.py and installed
# by deploy-app.sh.
#
# COMMITTED TO A PUBLIC REPO. Only non-secret values belong here. A value
# written as `SECRET` is not a value at all: it declares that the renderer must
# read it from the process environment (deploy-app.sh exports these out of
# deployment/.env, which is gitignored), and refuses to render if it is empty.
#
# This is the enforcement point for the rule that got broken once already: a
# real credential pasted here would be committed to a public repo, and the
# render would succeed silently. Leave these as SECRET.

# Upstream for /api/ride-note and /api/ride-status: the DESKTOP, over Tailscale.
# ride-watch drives tmux and the claude CLI under the user's login on rwtpc4, so
# it cannot move here; the routes have to resolve where the daemon actually is.
# deploy-app.sh exports this from HOME_TAILSCALE_IP.
RIDE_UPSTREAM=SECRET

# Stadia Maps geocoding key, injected server-side so it never reaches the phone.
STADIA_API_KEY=SECRET

# The long-lived /unlock cookie value. Rotating it is backlog 2.10 (needs root).
UNLOCK_SECRET=SECRET
