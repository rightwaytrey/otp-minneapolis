# house.env — value set for rwtpc4 (the desktop), rendered by render-nginx.py.
#
# COMMITTED TO A PUBLIC REPO. Only non-secret values belong here. A value
# written as `SECRET` is not a value at all: it declares that the renderer must
# read it from the process environment, and refuses to render if it is empty.

# Upstream for /api/ride-note and /api/ride-status. ride-watch runs on THIS box,
# so the daemon's Flask is simply local.
RIDE_UPSTREAM=127.0.0.1

# The long-lived /unlock cookie value. Rotating it is backlog 2.10 (needs root).
UNLOCK_SECRET=SECRET
# Stadia Maps geocoding key — same account as prod, injected server-side at
# render time from deployment/.env so it never reaches the phone (since 2026-09-04
# the house serves /pelias/v1 from Stadia too; backlog 9.8).
STADIA_API_KEY=SECRET
