# otp-common.conf.tmpl — the ONE source for the :9966 site's location blocks.
#
# Rendered per environment by deployment/render-nginx.py, which is called by
# deployment/deploy-app.sh (prod) and by `--env house` for rwtpc4. There is no
# second copy: config/nginx/ and deployment/nginx/ used to hold two
# hand-maintained forks 168 diff lines apart, and a fix applied to one was not
# deployed until somebody remembered the other.
#
# NOTHING may `cp` this file, or a render of it, onto a live nginx path by hand.
# The rendered file holds substituted secrets; this one holds placeholders.
# Installing either direction by hand is how the unlock secret reached a PUBLIC
# repo and sat there from 2026-06-01 to 2026-09-01.
#
# Template syntax (see render-nginx.py): a NAME wrapped in double underscores
# takes its value from deployment/env/<env>.env; `#@if <env>` / `#@else` /
# `#@endif` select regions; `#@one-sided` declares a location that deliberately
# renders in only some environments. An undeclared one-sided location fails
# `render-nginx.py --check`, which is what replaced check-nginx-parity.py.
#
#@one-sided /photon/api :: house only. Photon geocoder fallback the frontend stopped using in Jan 2026; the server never proxies komoot.io.
#@one-sided /delivery/api :: house only. The groupdelivery FastAPI on :8000 — an unrelated project that lives on the desktop.
    # --- Access control: whole site locked; only credentialed users get in. ---
    # Cookie holders skip the prompt (see map above); everyone else gets Basic Auth.
    # Add password users with:  sudo htpasswd /etc/nginx/.htpasswd <name>   (no -c)
    auth_basic           $otp_auth_realm;
    auth_basic_user_file /etc/nginx/.htpasswd;


    # SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # --- Rate-limit rejections must stay readable to a browser ---------------
    # A limit_req rejection is produced by NGINX, which never reached the
    # upstream - so it carries none of the upstream's CORS headers, and the
    # blocks below deliberately leave CORS to the upstream ("do NOT add_header
    # ACAO here or browsers reject the duplicate"). A browser therefore blocks
    # the rejection before the app can read its status, and fetch rejects with
    # an opaque TypeError ("Load failed" on iOS) carrying no Response at all.
    #
    # The app cannot tell that from the server being gone. On 2026-08-27 a
    # rider's search showed "an unknown error happened during the search", and
    # when every parallel query was rejected at once nothing resolved and the
    # spinner ran forever - against a server that was entirely healthy.
    #
    # So answer 429 (the honest status) from a named location that supplies the
    # CORS headers itself. Only the REJECTED request is routed here, so
    # successful responses still carry the upstream's own headers and nothing is
    # duplicated. Retry-After gives the client something to back off on.
    #
    # $http_origin, not '*': the app sends no credentials, but echoing the
    # origin matches what OTP2 does on the success path, so the app sees one
    # consistent CORS contract either way. nginx omits an add_header whose
    # value is empty, so a non-browser caller simply gets none.
    limit_req_status 429;
    error_page 429 = @cors429;

    location @cors429 {
        auth_basic off;
        default_type application/json;
        add_header 'Access-Control-Allow-Origin' $http_origin always;
        add_header 'Access-Control-Allow-Credentials' 'false' always;
        add_header 'Retry-After' '2' always;
        return 429 '{"errors":[{"message":"Rate limited. Retry shortly."}]}';
    }

    # One-time unlock: visit /unlock?key=<SECRET> to drop a 1-year access cookie,
    # then get redirected to the app. Reachable without Basic Auth, but requires
    # knowing the secret key. After this, the device never sees a login prompt.
    location = /unlock {
        auth_basic off;
        if ($arg_key != "__UNLOCK_SECRET__") {
            return 403;
        }
        add_header Set-Cookie "otp_access=__UNLOCK_SECRET__; Path=/; Max-Age=31536000; Secure; HttpOnly; SameSite=Lax";
        return 302 /;
    }

    # Optional: clear the cookie (re-locks this device, forcing Basic Auth again).
    location = /lock {
        auth_basic off;
        add_header Set-Cookie "otp_access=; Path=/; Max-Age=0";
        return 302 /;
    }

    # Proxy OTP API to backend on port 8090.
    # PUBLIC (rate-limited): the native app calls this cross-origin from
    # capacitor://localhost, where no cookie/Basic-Auth can ride along. Trip
    # planning is public transit data. OTP2 emits its own CORS headers (echoes
    # the Origin, handles OPTIONS preflight) — do NOT add_header ACAO here or
    # browsers will reject the duplicate.
    location /otp {
        auth_basic off;
        # One trip search fans out to several plan queries plus feeds and
        # stop/trip lookups, so burst=30 nodelay refused the tail of a single
        # legitimate search. Queue the overflow instead of refusing it: 30 go
        # straight through, the next 30 are paced at the zone rate, and only
        # past 60 does a caller get a 429. The sustained 10r/s ceiling is
        # unchanged - this is not a weaker limit, just a kinder one.
        limit_req zone=otp_api burst=60 delay=30;

        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # $host is the hostname with the port stripped, and OTP builds its
        # self-referential URLs from X-Forwarded-Host falling back to Host
        # (framework/io/HttpUtils.java getBaseAddress). The API is served ONLY
        # on $APP_PORT -- nothing listens on 443 for this name -- so with $host
        # alone the vector-tile tilejson answers 200 while naming tile URLs on
        # port 443 that refuse the connection, and the map's stop layer comes up
        # empty with nothing in any log. Measured 2026-09-02: tilejson through
        # this proxy returned tiles at "https://api.transit-nav.com/otp/..." and
        # that URL is connection-refused, while the same tile on :9966 is 21 kB
        # of protobuf. $http_host is the client's Host header verbatim, port
        # included. Setting it here also overrides any X-Forwarded-Host a client
        # sends, which nginx would otherwise pass through untouched.
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Natural-language routing-preferences API (Flask on 127.0.0.1:8092).
    # PUBLIC (rate-limited): Flask enforces its own 5/min/IP limit and owns the
    # CORS headers (flask-cors) — no ACAO here or browsers reject the duplicate.
    location /api/preferences {
        auth_basic off;
        limit_req zone=otp_ai burst=5 nodelay;

        proxy_pass http://127.0.0.1:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 4k;
    }

    # (The Go Mode push relay that used to live here at /api/go-notify is gone.
    # It forwarded alerts to the owner's personal Pushover account, which can
    # only ever notify one person — a rider who installs the app has no Pushover
    # account, and relaying their bus alerts would buzz the owner's phone. Go
    # Mode now raises system notifications on-device instead; see
    # lib/util/go-mode/native-notify.ts. The Flask handler still exists but is
    # only reachable on loopback.)

    # Onboard discovery for Go Mode's "I'm already on the bus" flow: which
    # live vehicles / route shapes are at the rider's GPS position (read-only
    # GETs; Flask enforces its own 60/min/IP on top). Replaces stop-proximity
    # discovery — a rider on freeway BRT between stations is on a route's map
    # line but near no stop.
    # PUBLIC (rate-limited): the native app calls this cross-origin.
    location /api/onboard/ {
        auth_basic off;
        limit_req zone=otp_ai burst=10 nodelay;

        proxy_pass http://127.0.0.1:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 1k;
    }

    # Go Mode debug-log sink -> Flask (127.0.0.1:8092) -> JSONL on disk. The
    # frontend streams its Redux action log + JS errors here for diagnosis.
    # Batches are larger than a push, so allow a roomier body.
    # PUBLIC (rate-limited): testers' native apps report here cross-origin;
    # Flask owns the CORS headers.
    #
    # client_max_body_size is the TOP rung of the record-path ladder and the
    # only hard one: nginx answers an oversized body 413, fetch() treats 413 as
    # a resolved response, and the client then drops the batch. Past this line a
    # payload is uploaded in full and thrown away, which is strictly worse than
    # stubbing it. It must stay above the client's MAX_BODY_BYTES (1,400,000):
    #   MAX_FULL_PAYLOAD_CHARS 1,000,000  (otprr lib/util/debug-log.js)
    #     < DEBUG_LOG_MAX_LINE_CHARS 1,179,648  (transitnav preferences_api.py)
    #       < MAX_BODY_BYTES 1,400,000  (otprr lib/util/debug-log.js)
    #         < client_max_body_size 1536k = 1,572,864  (here)
    # Raised from 512k on 2026-08-31: at 320k the 2026-08-28 evening ride lost
    # 30 REROUTE_SNAPSHOT / ONBOARD_CANDIDATE_SNAPSHOT payloads (up to 865,300
    # chars) to the summary stub and its reroutes could not be replayed.
    # scripts/check-config-ladder.py enforces the ordering, in the repo and
    # (with --deployed) against what is actually live. There is only one copy of
    # this block now: both hosts render it from this template.
    location /api/debug-log {
        auth_basic off;
        limit_req zone=otp_log burst=20 nodelay;

        proxy_pass http://127.0.0.1:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 1536k;
    }

    # --- Live web-bundle updates (Capacitor OTA) ----------------------------
    # The native shell asks this at every launch: "is there a newer www/ than
    # the one I am running?" Public and auth_basic off for the same reason as
    # every other route the bundled app calls — it runs at capacitor://localhost
    # and can carry no credential. It discloses only a version and a checksum.
    location /api/app-update {
        auth_basic off;
        limit_req zone=otp_ai burst=10 nodelay;

        proxy_pass http://127.0.0.1:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 8k;
    }

    # The bundle zips themselves (a few MB, once per release per device).
    # Served by the Flask app rather than as a static root because the bundles
    # live under $HOME, which nginx cannot traverse — and the app is what knows
    # which versions are real. The phone may be on cellular partway up a hill,
    # so the send timeout is generous.
    location /api/app-bundle/ {
        auth_basic off;
        limit_req zone=otp_api burst=10 nodelay;

        proxy_pass http://127.0.0.1:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    # Ride console (the /ride page below) -> Flask (127.0.0.1:8092).
    # /api/ride-note appends the rider's typed note to the same daily JSONL as
    # the telemetry, so ride-watch reads it in stream order and can pin it to
    # what the trip was doing at that second. /api/ride-status is the read-only
    # view of what the daemon currently sees.
    # PUBLIC (rate-limited): the page is opened from the phone's home screen —
    # a Basic Auth prompt appearing mid-ride is exactly the failure this whole
    # thing exists to avoid. Flask enforces its own 30/min (notes) and 60/min
    # (status) per IP and owns the CORS headers. otp_ai's 30r/m matches the
    # note budget; the status poll needs the burst, since 5s polling is 12/min.
    # Auth is off but the network is the gate: these three routes are TAILSCALE
    # ONLY (100.64.0.0/10, the CGNAT range Tailscale hands out). The rider's
    # phone reaches this server over the tailnet even on cell — every one of the
    # 12,872 events in the 7/29 ride logged 100.120.171.106 — so the restriction
    # costs the rider nothing, while /api/ride-status would otherwise hand the
    # rider's live location and trip state to anyone on the internet who asked.
    # UPSTREAM, per environment. On the house these two are the local Flask
    # (127.0.0.1). On the Linode they proxy back to the DESKTOP over Tailscale:
    # ride-watch stays on rwtpc4 (it drives tmux and the claude CLI under the
    # user's login), and /api/ride-note and /api/ride-status read and write the
    # daemon's files, so they have to resolve where the daemon actually is. The
    # tailnet gate above is unchanged and still does the real work.
    location /api/ride-note {
        auth_basic off;
        allow 100.64.0.0/10;
        allow 127.0.0.1;
        deny all;
        limit_req zone=otp_ai burst=10 nodelay;

        proxy_pass http://__RIDE_UPSTREAM__:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 4k;
    }

    location /api/ride-status {
        auth_basic off;
        allow 100.64.0.0/10;
        allow 127.0.0.1;
        deny all;
        limit_req zone=otp_ai burst=20 nodelay;

        proxy_pass http://__RIDE_UPSTREAM__:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 1k;
    }

    # The ride console itself: one self-contained HTML file, no build step, no
    # external requests (the phone may be on cell). It lives beside the app in
    # the web root but is not part of the app bundle — ride-watch/deploy-ride-
    # console.sh installs it, and frontend/deploy-prod.sh re-runs that after its
    # rsync --delete. Exact-match location so the app's catch-all try_files
    # doesn't swallow /ride and serve index.html instead. no-cache for the same
    # reason as /index.html: a home-screen shortcut must not pin a stale page.
    location = /ride {
        auth_basic off;
        allow 100.64.0.0/10;
        allow 127.0.0.1;
        deny all;
        default_type text/html;
        alias /var/www/transitnav/ride.html;
        add_header Cache-Control "no-cache";
    }

    # --- Geocoding: the desktop's Pelias, BOTH HOSTS ---------------------------
    # 2026-09-05: the Stadia Professional trial ends 2026-09-08 and the free tier
    # keeps neither forward nor reverse geocoding (backlog 9.9), so the geocoder
    # is the local Pelias on the desktop again (68 GB corpus, pelias/ compose,
    # ~4 GB resident) — for BOTH hosts. The house proxies straight to the
    # container; the server proxies over the tailnet to the HOUSE'S nginx on
    # :9966 (TLS, rate-limited, already reachable), not to :4000 directly, so
    # nothing new is opened on the desktop and the container stays bound to
    # 127.0.0.1. Cost: production address search depends on the desktop being
    # up. The Stadia variant (regex capture -> api.stadiamaps.com with the key
    # injected server-side) is in git history at 3abb37c if it is ever paid for.
    #
    # The path MUST stay /pelias/v1/* (docs/API-COMPAT.md rules 1-3). A
    # trailing-slash proxy_pass strips the matched "/pelias/" prefix, so the
    # house forwards "/v1/autocomplete" to pelias-api and the server forwards
    # "/pelias/v1/autocomplete" to the house. Pelias emits its own CORS headers
    # (ACAO *, answers OPTIONS); adding ours here would duplicate them.
    # Upstream is a literal, not a variable, so no resolver is needed and the
    # server's copy uses the desktop's tailnet IP rather than a MagicDNS name
    # that may not resolve when nginx starts at boot.
    location /pelias/ {
        auth_basic off;
        limit_req zone=otp_api burst=20 nodelay;
        proxy_pass __PELIAS_UPSTREAM__;
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_ssl_name __PELIAS_HOST__;
        proxy_set_header Host __PELIAS_HOST__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 15s;
    }

#@if house
    # --- Desktop-only proxies -------------------------------------------------
    # Two proxies the server deliberately does not have. See the #@one-sided
    # declarations in the header for why each is one-sided.
    # Proxy Geocoder API to avoid CORS issues
    # PhotonGeocoder sends requests to /photon/api (baseUrl + "/api")
    # Use variable-based proxy_pass to avoid DNS resolution at startup
    location /photon/api {
        auth_basic off;
        limit_except OPTIONS {
            auth_basic           $otp_auth_realm;
            auth_basic_user_file /etc/nginx/.htpasswd;
        }

        resolver 127.0.0.53 valid=300s;
        resolver_timeout 5s;
        set $photon_upstream https://photon.komoot.io;
        proxy_pass $photon_upstream/api$is_args$args;
        proxy_ssl_server_name on;
        proxy_set_header Host photon.komoot.io;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # Add CORS headers
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, OPTIONS' always;
        add_header 'Access-Control-Allow-Headers' 'Content-Type' always;

        # Handle preflight
        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }

    # Group Delivery API - proxy to FastAPI backend on port 8000
    location /delivery/api {
        auth_basic off;
        limit_except OPTIONS {
            auth_basic           $otp_auth_realm;
            auth_basic_user_file /etc/nginx/.htpasswd;
        }

        rewrite ^/delivery/api/(.*)$ /api/$1 break;
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CORS headers
        add_header 'Access-Control-Allow-Origin' '*' always;
        add_header 'Access-Control-Allow-Methods' 'GET, POST, PUT, DELETE, OPTIONS, PATCH' always;
        add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization, X-Requested-With' always;

        # Handle preflight
        if ($request_method = 'OPTIONS') {
            return 204;
        }
    }
#@endif

    # Serve the STATIC production build (no HMR, no websocket, nothing that can
    # reload the app out from under a live trip). Rebuild + redeploy with
    # frontend/deploy-prod.sh. The app uses hash routing, so every route is "/"
    # and try_files falls back to index.html. The dev server on :9967 stays up
    # for development but is no longer in the serving path.
    #
    # Caching: without an explicit Cache-Control, the iOS WebView heuristically
    # caches index.html and keeps loading a STALE bundle after a deploy (seen
    # 2026-07-11: phone ran a day-old build hours after two deploys). The entry
    # document must always revalidate; the content-hashed assets under it are
    # immutable and can cache forever.
    location = /index.html {
        root /var/www/transitnav;
        add_header Cache-Control "no-cache";
    }
    location / {
        root /var/www/transitnav;
        try_files $uri /index.html;
    }
