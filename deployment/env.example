# Copy to .env (gitignored) before running provision-linode.sh.
#
# Linode auth comes from the system linode-cli config (~/.config/linode-cli),
# which is already set up on this box — `linode-cli account view` proves it.

# --- Server ---------------------------------------------------------------
# us-ord is Chicago, the closest region to Minneapolis (~10ms). Do not use
# ap-southeast; that is where the unrelated tradingbot instances live.
LINODE_REGION=us-ord
# 2 vCPU / 4 GB / 80 GB. Sized in the migration plan: OTP -Xmx2G (2.3 GB) +
# prefs-api and nginx (0.2) + OS and dockerd (0.7) = 3.2 GB steady.
# Resize to g6-standard-4 (8 GB) with one reboot if OTP needs more room.
LINODE_TYPE=g6-standard-2
LINODE_IMAGE=linode/ubuntu24.04
LINODE_LABEL=transitnav
# Blank = auto-generate a strong password that is never displayed (SSH keys only).
LINODE_ROOT_PASSWORD=

# --- SSH ------------------------------------------------------------------
SSH_PUBLIC_KEY_PATH=~/.ssh/id_rsa.pub
DISABLE_PASSWORD_AUTH=true

# --- Application ----------------------------------------------------------
APP_USER=rwt
# The public name the iOS app has hardcoded. Do not change it: the shipped
# TestFlight builds call https://api.transit-nav.com:9966 and keeping the
# hostname AND port identical is what makes this a DNS change with no rebuild.
DOMAIN=api.transit-nav.com
APP_PORT=9966

# --- Home box (stays in the loop for the graph build and ride-watch) -------
# Tailscale IP of rwtpc4. The server proxies /api/ride-note and
# /api/ride-status here, and the nightly graph build pushes graph.obj up.
HOME_TAILSCALE_IP=100.72.153.99

# --- Secrets (never commit) -----------------------------------------------
# Cloudflare Zone:DNS:Edit token, for certbot's DNS-01 renewal. DNS-01 is the
# whole point of this hostname: no inbound :80, so no port-forward to vanish.
CF_TOKEN=
# Stadia Maps geocoding key. Create free at https://client.stadiamaps.com/
# Injected server-side by nginx so it never reaches the phone.
STADIA_API_KEY=
# Tailscale auth key (tskey-auth-...), so the server can join the tailnet
# unattended. Generate at https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=
# One-time unlock key. Visiting /unlock?key=<this> drops a 1-year cookie so the
# device never sees the Basic Auth prompt again; the same value is the cookie
# body nginx matches on. Substituted into both nginx templates at deploy time,
# so it is never committed. The value currently live on the server is in .env —
# the copies still sitting in config/nginx/ are the pre-migration desktop
# config and are due for rotation.
UNLOCK_SECRET=

# Server-side override for routingDefaults.accessEgress.maxStopCount (empty = use
# whatever the repo config says). The bike ACCESS RADIUS must not be lowered --
# exurban origins genuinely need 72-78 min of it -- but the stop count is the
# expensive half and appears heavily oversized. See scripts/stopcount-sweep.py.
SERVER_MAX_STOP_COUNT=
